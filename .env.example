# Supabase Configuration
# Copy this file to .env and fill in your actual Supabase credentials
# Get these from your Supabase project settings > API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: These are public environment variables (prefixed with EXPO_PUBLIC_)
# They will be included in your bundle and visible to clients
# Only use the anon key here, never your service role key